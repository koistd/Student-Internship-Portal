rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /resumes/{applicationId}/{fileName} {
      allow read: if request.auth != null && (
        firestore.get(/databases/(default)/documents/applications/$(applicationId)).data.studentId == request.auth.uid ||
        firestore.get(/databases/(default)/documents/internships/$(firestore.get(/databases/(default)/documents/applications/$(applicationId)).data.internshipId)).data.postedBy == request.auth.uid ||
        request.auth.token.admin == true
      );
      allow write: if request.auth != null && firestore.get(/databases/(default)/documents/applications/$(applicationId)).data.studentId == request.auth.uid && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType == 'application/pdf';
    }
  }
}