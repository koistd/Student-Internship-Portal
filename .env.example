# =============================================================
# Student Internship & Placement Portal — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================

# --- Django Core ---
DJANGO_ENV=production
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.yourdomain.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://app.yourdomain.com

# --- Database ---
DATABASE_URL=postgresql://db_user:db_password@db.yourdomain.com:5432/placement_portal

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Media / File Storage ---
MEDIA_ROOT=/var/www/placement_portal/media
STATIC_ROOT=/var/www/placement_portal/staticfiles

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# --- Frontend ---
VITE_API_URL=https://api.yourdomain.com/api

# --- Email ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# --- API ---
API_PAGE_SIZE=25
DJANGO_LOG_LEVEL=INFO

# Optional development-only sample data command
# SAMPLE_DATA_PASSWORD=choose-a-local-only-password
